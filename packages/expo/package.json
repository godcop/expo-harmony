{
  "name": "@expo-harmony/expo",
  "version": "55.0.26-harmony.1",
  "description": "HarmonyOS native integration for Expo",
  "keywords": [
    "react-native",
    "expo",
    "expo-harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/renbaoshuo/expo-harmony/tree/master/packages/expo#readme",
  "bugs": "https://github.com/renbaoshuo/expo-harmony/issues",
  "license": "MIT",
  "author": "Baoshuo <i@baoshuo.ren>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renbaoshuo/expo-harmony.git",
    "directory": "packages/expo"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "harmony:clean": "expo-harmony-module prepare --clean-only",
    "harmony:build": "expo-harmony-module prepare",
    "prepack": "expo-harmony-module prepack"
  },
  "peerDependencies": {
    "expo": "55.0.26"
  },
  "devDependencies": {
    "@expo-harmony/expo-module-scripts": "workspace:*",
    "@expo-harmony/expo-modules-core": "workspace:*",
    "@react-native-oh/react-native-harmony": "0.84.1",
    "expo": "55.0.26",
    "expo-modules-core": "55.0.25",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@expo-harmony/expo-modules-core": "workspace:*"
  },
  "harmony": {
    "autolinking": {
      "mainHarPath": "harmony",
      "ohPackageName": "@expo-harmony/expo",
      "etsPackageClassName": "ExpoPackage",
      "etsPackageImport": "named",
      "cppPackageClassName": "ExpoPackage",
      "cmakeLibraryTargetName": "expo_harmony__expo"
    }
  }
}
